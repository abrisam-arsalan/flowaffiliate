# ── Log & artefak pengembangan ──────────────────────────────
# `/_*.txt` menangkap semua file temp yang dibuat di root repo
# (termasuk pesan commit) supaya tidak ikut ter-commit lagi.
/_*.txt
/_*.pid
_srv-*.txt
_srv.pid
_fg-*.txt
_server.log
_testout.txt

# ── KRITIS: penyimpanan profil API ──────────────────────────
# `_ai-profiles.json` memuat SELURUH API key dalam bentuk asli.
# Jangan pernah menambahkan berkas ini ke repo publik.
# Server juga sudah menolak menyajikannya lewat HTTP (segmen berawalan `_`),
# tapi aturan di sini mencegahnya ikut ter-commit.
_ai-profiles.json
_ai-profiles.json.tmp

# ── Dependensi ──────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Artefak build ───────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Env & rahasia ───────────────────────────────────────────
# API key disimpan di `.env` dan HANYA dibaca oleh server.ts.
# Key tidak pernah dikirim ke browser, jadi tidak ada yang bisa mencurinya
# dari sisi klien. `.env.example` sengaja diizinkan agar tetap bisa
# di-commit sebagai template.
.env
.env.*
!.env.example

# ── Sistem & editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/*
!.vscode/extensions.json
