# ─────────────────────────────────────────────────────────────────────
# FlowAffiliate — contoh konfigurasi
#
# Salin file ini menjadi `.env` lalu isi nilainya:
#     Copy-Item .env.example .env
#
# `.env` SUDAH masuk .gitignore, jadi API key tidak akan ikut ter-commit.
# Jangan pernah menuliskan key asli di file ini.
# ─────────────────────────────────────────────────────────────────────

# Base URL gateway AI (harus kompatibel dengan endpoint OpenAI
# `POST {AI_BASE_URL}/chat/completions`).
# Contoh: https://gateway.example.com/v1
AI_BASE_URL=

# API key gateway.
AI_API_KEY=

# Model yang bisa membaca GAMBAR, dipakai untuk menganalisis foto produk.
# Pilih dari daftar model Anda yang bertanda "Vision".
# Contoh: glm-5.3-flash (2x), mimo-v2.6-pro (2x), kimi-k3 (2x)
AI_VISION_MODEL=glm-5.3-flash

# Daftar model vision yang BOLEH DIPILIH dari halaman Pengaturan, dipisah koma.
# Ini pembatas keamanan: tanpa daftar ini browser hanya boleh memakai
# AI_VISION_MODEL, sehingga klien tidak bisa menyuruh server memanggil model
# apa pun yang ada di gateway Anda.
#
# Hanya model bertanda Vision yang bisa dipakai di sini. Yang tersedia:
#   glm-5.3-flash              (2x)     <- termurah, cukup untuk kebanyakan produk
#   kimi-k3                    (2x)
#   mimo-v2.6-pro              (2x)
#   glm-5.3-flashx             (2.5x)
#   deepseek-v4-flash-vision-exp (2.5x)
#   deepseek-v4.1-flash        (2.56x)
#   gpt-5.6                    (5x)     <- paling mahal, paling teliti
#   gpt-5.6-luna               (5x)
AI_VISION_MODELS=glm-5.3-flash,kimi-k3,mimo-v2.6-pro,gpt-5.6

# Model untuk menulis ulang narasi. Boleh model teks saja, lebih murah.
# Contoh: mimo-v2.5-pro (1.4x), deepseek-v4-flash (2x)
AI_TEXT_MODEL=mimo-v2.5-pro

# Batas waktu satu permintaan ke gateway (milidetik).
AI_TIMEOUT_MS=60000

# Mode uji: balas analisis contoh TANPA memanggil jaringan.
# Berguna untuk mencoba alur tanpa menghabiskan kuota. Set ke 1 untuk aktif.
AI_MOCK=0

# Port server lokal.
PORT=3000
